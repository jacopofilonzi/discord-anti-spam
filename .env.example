# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# --- Optional tuning (defaults shown) ---
# Identical messages needed to trigger the protection
SPAM_THRESHOLD=3
# Time window (seconds) in which the messages must be sent
SPAM_WINDOW_SECONDS=60
# Minimum number of distinct channels the messages must span
SPAM_MIN_CHANNELS=2
# Messages shorter than this (without links or attachments) are ignored
MIN_CONTENT_LENGTH=8
# Timeout applied to the user, in minutes (10080 = 7 days, Discord max is 40320 = 28 days)
TIMEOUT_MINUTES=10080
# SQLite database location
DATABASE_PATH=./data/dity.db
